{
  "name": "BucHunt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:admin": "tsc src/server/admin.ts --target ES2022 --module commonjs --lib ES2022,DOM --strict --skipLibCheck --outDir",
    "check:admin": "tsc src/server/admin.ts --target ES2022 --module commonjs --lib ES2022,DOM --strict --skipLibCheck --noEmit",
    "test:admin": "node --experimental-strip-types --test src/server/admin.test.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "serve": "serve src -l 3000"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22.18.0" },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.0",
    "eslint": "^9.39.4",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0"
  }
}
